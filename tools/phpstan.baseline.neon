parameters:
	ignoreErrors:
		-
			message: '#^Call to function is_string\(\) with mixed will always evaluate to false\.$#'
			identifier: function.impossibleType
			count: 1
			path: ../src/DI/MonologExtension.php

		-
			message: '#^Only booleans are allowed in a ternary operator condition, \(int\|string\) given\.$#'
			identifier: ternary.condNotBoolean
			count: 1
			path: ../src/Tracy/LazyTracyToPsrLogger.php

		-
			message: '#^Method Tests\\OriNette\\Monolog\\Doubles\\ExtendedTestHandler\:\:getProcessors\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 2
			path: ../tests/Doubles/ExtendedTestHandler.php

		-
			message: '#^Method Tests\\OriNette\\Monolog\\Doubles\\ExtendedTestHandler\:\:getProcessors\(\) should return array\<\(callable\(array\)\: array\)\|Monolog\\Processor\\ProcessorInterface\> but returns array\<callable\(Monolog\\LogRecord\)\: Monolog\\LogRecord\>\.$#'
			identifier: return.type
			count: 1
			path: ../tests/Doubles/ExtendedTestHandler.php

		-
			message: '#^Property Tests\\OriNette\\Monolog\\Doubles\\TestMailer\:\:\$mails type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: ../tests/Doubles/TestMailer.php

		-
			message: '#^Instanceof between Monolog\\Level and Monolog\\Level will always evaluate to true\.$#'
			identifier: instanceof.alwaysTrue
			count: 1
			path: ../tests/Doubles/UnresettableSimpleTestHandler.php

		-
			message: '#^Parameter \#1 \$level of static method Monolog\\Logger\:\:toMonologLevel\(\) expects 100\|200\|250\|300\|400\|500\|550\|600\|''ALERT''\|''alert''\|''CRITICAL''\|''critical''\|''DEBUG''\|''debug''\|''EMERGENCY''\|''emergency''\|''ERROR''\|''error''\|''INFO''\|''info''\|''NOTICE''\|''notice''\|''WARNING''\|''warning''\|Monolog\\Level, int\|Monolog\\Level\|string given\.$#'
			identifier: argument.type
			count: 1
			path: ../tests/Doubles/UnresettableSimpleTestHandler.php

		-
			message: '#^Cannot access offset 1 on callable\(\)\: mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 2
			path: ../tests/Unit/DI/MonologExtensionTest.php

		-
			message: '#^Call to static method PHPUnit\\Framework\\Assert\:\:assertNotNull\(\) with null will always evaluate to false\.$#'
			identifier: staticMethod.impossibleType
			count: 1
			path: ../tests/Unit/Tracy/LazyTracyToPsrLoggerTest.php

		-
			message: '#^Dead catch \- Orisai\\Exceptions\\Logic\\MemberInaccessible is never thrown in the try block\.$#'
			identifier: catch.neverThrown
			count: 1
			path: ../tests/Unit/Tracy/LazyTracyToPsrLoggerTest.php

		-
			message: '#^Expression "\$logger\-\>fromEmail" on a separate line does not do anything\.$#'
			identifier: expr.resultUnused
			count: 1
			path: ../tests/Unit/Tracy/LazyTracyToPsrLoggerTest.php

		-
			message: '#^Parameter \#1 \$record of method Monolog\\Handler\\AbstractProcessingHandler\:\:handle\(\) expects Monolog\\LogRecord, array\<string, array\|DateTimeImmutable\|int\|string\>\|Monolog\\LogRecord given\.$#'
			identifier: argument.type
			count: 2
			path: ../tests/Unit/Tracy/TracyPanelHandlerTest.php
